# IntelliJ does not load this file. Defaults are in src/main/resources/application.yml.
# Only set a variable here if you also pass it into the process (terminal or IDE env).
# The names below are the ${...} placeholders used in application.yml.

# spring.datasource.password
# Edit this to your local PostgreSQL password for user postgres.
# The same value is the default after the colon in application.yml.
DB_PASSWORD=your-postgres-password
# app.jwt.secret (at least 32 characters)
JWT_SECRET=change-this-dev-secret-key-to-a-long-random-string-32b

# app.jwt.expiration-ms
JWT_EXPIRATION_MS=86400000

# app.upload-dir
UPLOAD_DIR=uploads

# app.max-signature-bytes (multipart limit is 2MB in application.yml)
MAX_FILE_SIZE_BYTES=2097152

# app.timezone and hibernate.jdbc.time_zone
APP_TIMEZONE=Asia/Kolkata

# server.port
SERVER_PORT=8081

# app.cors-origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
